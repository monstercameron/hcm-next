# Local API environment overrides. Copy to `.env` and fill in values.
# `.env` is gitignored — never commit secrets here.

# Set to enable real GPT-4o page generation. When unset, the API uses the
# deterministic NullAiClient which renders a static placeholder page.
# OPENAI_API_KEY=sk-...

# Optional model override; defaults to gpt-4o
# OPENAI_MODEL=gpt-4o

# API listen port; default 3000 (Grafana clashes on some local setups)
# PORT=3001
