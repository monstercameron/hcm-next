{
  "schemaVersion": "v0.4",
  "metadata": {
    "schemaVersion": "v0.4",
    "title": "Employee contact information update",
    "description": "Self-service contact information update with HR approval and deterministic HRIS transaction planning.",
    "domain": "worker",
    "owner": "hcm-workflow-platform",
    "tags": ["worker", "employee_contact_info_update"],
    "deterministicBlockRefs": {
      "preflight": {
        "name": "system.employee_data.contact_info.preflight",
        "version": "1.0.0",
        "runtime": "go"
      },
      "planTransaction": {
        "name": "system.employee_data.contact_info.plan_transaction",
        "version": "1.0.0",
        "runtime": "go"
      }
    }
  },
  "intent": "employee.contact_info.update",
  "subjectType": "worker",
  "selfServiceStart": true,
  "ui": {
    "defaultInteraction": "input",
    "stateInteractions": {
      "collecting_input": "input",
      "waiting_approval": "waitingApproval",
      "approved": "readyToExecute"
    }
  },
  "interactions": {
    "input": {
      "type": "form",
      "schemaVersion": "v0.2",
      "title": "Update contact information",
      "employeeContext": [
        {
          "outputKey": "currentContactInfo",
          "path": "contact"
        }
      ],
      "jsonSchema": {
        "type": "object",
        "required": ["proposedContactInfo", "effectiveAt", "businessReason"],
        "properties": {
          "proposedContactInfo": {
            "type": "object",
            "required": ["personalEmail", "mobilePhone", "homeAddress"],
            "properties": {
              "personalEmail": {
                "type": ["string", "null"]
              },
              "mobilePhone": {
                "type": ["string", "null"]
              },
              "homeAddress": {
                "type": "object",
                "required": ["line1", "city", "region", "postalCode", "country"],
                "properties": {
                  "line1": {
                    "type": "string",
                    "minLength": 1
                  },
                  "line2": {
                    "type": ["string", "null"]
                  },
                  "city": {
                    "type": "string",
                    "minLength": 1
                  },
                  "region": {
                    "type": "string",
                    "minLength": 1
                  },
                  "postalCode": {
                    "type": "string",
                    "minLength": 1
                  },
                  "country": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 2
                  }
                }
              }
            }
          },
          "effectiveAt": {
            "type": "string",
            "format": "date"
          },
          "businessReason": {
            "type": "string",
            "enum": ["employee_self_service", "relocation", "correction", "other"]
          }
        }
      },
      "uiSchema": {
        "layout": "sectioned_form",
        "submitLabel": "Submit for review"
      }
    },
    "waitingApproval": {
      "type": "waiting",
      "title": "Waiting for HR approval"
    },
    "readyToExecute": {
      "type": "ready_to_execute",
      "title": "Ready to execute contact information update"
    }
  },
  "states": {
    "collecting_input": {
      "actions": [
        {
          "transition": "submit_input",
          "label": "Submit for review",
          "actor": "requester",
          "handler": "submit_configured_input",
          "nextState": "waiting_approval",
          "nextStatus": "waiting",
          "nextInteraction": "waitingApproval"
        },
        {
          "transition": "cancel",
          "label": "Cancel",
          "actor": "requester",
          "handler": "cancel"
        }
      ]
    },
    "waiting_approval": {
      "actions": [
        {
          "transition": "approve",
          "label": "Approve",
          "actor": "hr_admin",
          "handler": "approve"
        },
        {
          "transition": "reject",
          "label": "Reject",
          "actor": "hr_admin",
          "handler": "reject"
        },
        {
          "transition": "cancel",
          "label": "Cancel request",
          "actor": "requester",
          "handler": "cancel"
        }
      ]
    },
    "approved": {
      "actions": [
        {
          "transition": "execute",
          "label": "Execute change",
          "actor": "hr_admin_or_system",
          "handler": "execute"
        }
      ]
    }
  },
  "submit": {
    "preflightBlock": {
      "name": "system.employee_data.contact_info.preflight",
      "version": "1.0.0",
      "runtime": "go"
    },
