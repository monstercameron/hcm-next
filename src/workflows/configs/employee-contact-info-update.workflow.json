            "nextNodeId": "sync_contact_info_hris",
            "routeKey": "recorded"
          }
        ]
      },
      {
        "nodeId": "sync_contact_info_hris",
        "type": "external_write",
        "title": "Queue contact information update HRIS sync",
        "connectionId": "fake_hris",
        "operation": "updateContactInfo",
        "transaction": {
          "sideEffect": true,
          "idempotency": {
            "scope": "node",
            "keyTemplate": "contact_info_hris.${workflow.workflowInstanceId}",
            "onDuplicate": "read_existing_result"
          },
          "reversibility": "manual_repair",
          "retryPolicy": {
            "maxAttempts": 3,
            "backoff": "exponential",
            "retryOn": ["timeout", "rate_limited", "transient_5xx"]
          },
          "failurePolicy": {
            "onFailure": "retry_then_repair",
            "retryPolicy": {
              "maxAttempts": 3,
              "backoff": "exponential",
              "retryOn": ["timeout", "rate_limited", "transient_5xx"]
            },
            "afterRetriesExhausted": {
              "runCompensation": true,
              "nextNodeId": "failed",
              "nextState": "failed",
              "nextStatus": "failed",
              "eventType": "WorkflowFailed"
            }
          },
          "idempotencyKeyPath": "transactionPlan.idempotencyKey"
        },
        "outcomes": [
          {
            "outcome": "requested",
            "eventType": "ExternalWriteRequested",
            "nextNodeId": "completed",
            "routeKey": "requested"
          },
          {
            "outcome": "retryable_failure",
            "eventType": "ExternalWriteFailed",
            "nextNodeId": "failed",
            "nextState": "failed",
            "nextStatus": "failed",
            "routeKey": "retryable_failure"
