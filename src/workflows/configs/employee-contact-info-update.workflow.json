      },
      "effectiveAt": {
        "$source": "input",
        "path": "effectiveAt"
      },
      "businessReason": {
        "$source": "input",
        "path": "businessReason"
      }
    },
    "effectiveAt": {
      "$source": "input",
      "path": "effectiveAt"
    },
    "businessReason": {
      "$source": "input",
      "path": "businessReason"
    },
    "changeRequestStatus": "in_approval",
    "markSubmitted": true,
    "createApprovalTask": true,
    "currentSnapshot": {
      "contactInfo": {
        "$source": "employee",
        "path": "contact"
      }
    },
    "proposedSnapshot": {
      "contactInfo": {
        "$source": "input",
        "path": "proposedContactInfo"
      }
    },
    "proposedChange": {
      "targetObjectType": "worker",
      "targetObjectId": {
        "$source": "workflow",
        "path": "subjectId"
      },
      "fieldPath": "contact",
      "currentValue": {
        "$source": "employee",
        "path": "contact"
      },
      "proposedValue": {
        "$source": "input",
        "path": "proposedContactInfo"
      }
    },
    "additionalEvents": [
      "ProposedChangeCreated",
      "ContactInfoPreflighted",
      "ApprovalTaskCreated",
      "ChangeRequestSubmitted"
    ]
  },
  "approval": {
    "assigneeActorId": "actor_hr_admin_riley",
    "assigneeRole": "hr_admin",
    "approvalType": "hr_contact_info_review"
  },
  "plan": {
    "block": {
      "name": "system.employee_data.contact_info.plan_transaction",
      "version": "1.0.0",
