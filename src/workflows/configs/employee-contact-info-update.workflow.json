            "nextState": "failed",
            "nextStatus": "failed",
            "routeKey": "failed"
          }
        ]
      },
      {
        "nodeId": "apply_contact_info_projection",
        "type": "projection_write",
        "title": "Apply contact information update projection",
        "transaction": {
          "sideEffect": true,
          "idempotency": {
            "scope": "node",
            "keyTemplate": "contact_info_projection.${workflow.workflowInstanceId}",
            "onDuplicate": "read_existing_result"
          },
          "reversibility": "compensatable",
          "retryPolicy": {
            "maxAttempts": 3,
            "backoff": "exponential",
            "retryOn": ["timeout", "rate_limited", "transient_5xx"]
          },
          "failurePolicy": {
            "onFailure": "retry_then_compensate",
            "retryPolicy": {
              "maxAttempts": 3,
              "backoff": "exponential",
              "retryOn": ["timeout", "rate_limited", "transient_5xx"]
            },
            "afterRetriesExhausted": {
              "runCompensation": true,
              "nextNodeId": "failed",
              "nextState": "failed",
              "nextStatus": "failed",
              "eventType": "WorkflowFailed"
            }
          }
        },
        "outcomes": [
          {
            "outcome": "applied",
            "eventType": "EmployeeContactInfoUpdated",
            "nextNodeId": "record_contact_info_projection_update",
            "routeKey": "applied"
