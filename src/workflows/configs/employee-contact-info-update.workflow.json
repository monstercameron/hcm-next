      },
      "workerId": {
        "$source": "workflow",
        "path": "subjectId"
      },
      "currentContactInfo": {
        "$source": "employee",
        "path": "contact"
      },
      "proposedContactInfo": {
        "$source": "proposedChange",
        "path": "proposedValue"
      },
      "effectiveAt": {
        "$source": "changeRequest",
        "path": "effectiveAt"
      }
    }
  },
  "graph": {
