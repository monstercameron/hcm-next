{
  "intent": "employee.contact_info.update",
  "subjectType": "worker",
  "selfServiceStart": true,
  "interactions": {
    "input": {
      "type": "form",
      "schemaVersion": "v0.2",
      "title": "Update contact information",
      "employeeContext": [
        {
          "outputKey": "currentContactInfo",
          "path": "contact"
        }
      ],
      "jsonSchema": {
        "type": "object",
        "required": ["proposedContactInfo", "effectiveAt", "businessReason"],
        "properties": {
          "proposedContactInfo": {
            "type": "object",
            "required": ["personalEmail", "mobilePhone", "homeAddress"],
            "properties": {
              "personalEmail": { "type": ["string", "null"] },
              "mobilePhone": { "type": ["string", "null"] },
              "homeAddress": {
                "type": "object",
                "required": ["line1", "city", "region", "postalCode", "country"],
                "properties": {
                  "line1": { "type": "string", "minLength": 1 },
                  "line2": { "type": ["string", "null"] },
                  "city": { "type": "string", "minLength": 1 },
                  "region": { "type": "string", "minLength": 1 },
                  "postalCode": { "type": "string", "minLength": 1 },
                  "country": { "type": "string", "minLength": 2, "maxLength": 2 }
                }
              }
            }
          },
          "effectiveAt": { "type": "string", "format": "date" },
          "businessReason": {
            "type": "string",
            "enum": ["employee_self_service", "relocation", "correction", "other"]
          }
        }
      },
      "uiSchema": {
        "layout": "sectioned_form",
        "submitLabel": "Submit for review"
      }
    },
    "waitingApproval": {
      "type": "waiting",
      "title": "Waiting for HR approval"
    },
    "readyToExecute": {
      "type": "ready_to_execute",
      "title": "Ready to execute contact information update"
    }
  },
  "states": {
    "collecting_input": {
      "actions": [
        {
          "transition": "submit_input",
          "label": "Submit for review",
          "actor": "requester",
          "handler": "submit_configured_input",
          "nextState": "waiting_approval",
          "nextStatus": "waiting",
          "nextInteraction": "waitingApproval"
        },
        {
          "transition": "cancel",
          "label": "Cancel",
          "actor": "requester",
          "handler": "cancel"
        }
      ]
    },
    "waiting_approval": {
      "actions": [
        {
          "transition": "approve",
          "label": "Approve",
          "actor": "hr_admin",
          "handler": "approve"
        },
        {
          "transition": "reject",
          "label": "Reject",
          "actor": "hr_admin",
          "handler": "reject"
        },
        {
          "transition": "cancel",
          "label": "Cancel request",
          "actor": "requester",
          "handler": "cancel"
        }
      ]
    },
    "approved": {
      "actions": [
        {
          "transition": "execute",
          "label": "Execute change",
          "actor": "hr_admin_or_system",
          "handler": "execute"
        }
      ]
    }
  },
  "submit": {
    "preflightBlock": {
      "name": "system.employee_data.contact_info.preflight",
      "version": "1.0.0"
    },
    "preflightInput": {
      "currentContactInfo": { "$source": "employee", "path": "contact" },
      "proposedContactInfo": {
        "$source": "input",
        "path": "proposedContactInfo"
      },
      "effectiveAt": { "$source": "input", "path": "effectiveAt" },
      "businessReason": { "$source": "input", "path": "businessReason" }
    },
    "effectiveAt": { "$source": "input", "path": "effectiveAt" },
    "businessReason": { "$source": "input", "path": "businessReason" },
    "changeRequestStatus": "in_approval",
    "markSubmitted": true,
    "createApprovalTask": true,
    "currentSnapshot": {
      "contactInfo": { "$source": "employee", "path": "contact" }
    },
    "proposedSnapshot": {
      "contactInfo": { "$source": "input", "path": "proposedContactInfo" }
    },
    "proposedChange": {
      "targetObjectType": "worker",
      "targetObjectId": { "$source": "workflow", "path": "subjectId" },
      "fieldPath": "contact",
      "currentValue": { "$source": "employee", "path": "contact" },
      "proposedValue": {
        "$source": "input",
        "path": "proposedContactInfo"
      }
    },
    "additionalEvents": [
      "ProposedChangeCreated",
      "ContactInfoPreflighted",
      "ApprovalTaskCreated",
      "ChangeRequestSubmitted"
    ]
  },
  "approval": {
    "assigneeActorId": "actor_hr_admin_riley",
    "assigneeRole": "hr_admin",
    "approvalType": "hr_contact_info_review"
  },
  "plan": {
    "block": {
      "name": "system.employee_data.contact_info.plan_transaction",
      "version": "1.0.0"
    },
    "input": {
      "changeRequestId": { "$source": "changeRequest", "path": "changeRequestId" },
      "workerId": { "$source": "workflow", "path": "subjectId" },
      "currentContactInfo": { "$source": "employee", "path": "contact" },
      "proposedContactInfo": {
        "$source": "proposedChange",
        "path": "proposedValue"
      },
      "effectiveAt": { "$source": "changeRequest", "path": "effectiveAt" }
    }
  },
  "projection": {
    "allowedPatchPaths": [
      "/contact/personalEmail",
      "/contact/mobilePhone",
      "/contact/homeAddress"
    ]
  },
  "timeline": {
    "businessEvents": [
      "WorkflowIntentStarted",
      "ChangeRequestCreated",
      "ContactInfoPreflighted",
      "ApprovalTaskCreated",
      "ApprovalGranted",
      "TransactionPlanCreated",
      "EmployeeContactInfoUpdated",
      "ExternalWriteRequested",
      "WorkflowCompleted"
    ],
    "summaries": {
      "WorkflowIntentStarted": "Contact information update workflow started.",
      "ChangeRequestCreated": "Contact information update request submitted.",
      "ContactInfoPreflighted": "Contact information preflight completed.",
      "ApprovalTaskCreated": "HR approval task created.",
      "ApprovalGranted": "HR approved the contact information update.",
      "TransactionPlanCreated": "Transaction plan created.",
      "EmployeeContactInfoUpdated": "Contact information updated in the employee projection.",
      "ExternalWriteRequested": "External HRIS sync was queued.",
      "WorkflowCompleted": "Workflow completed."
    }
  }
}
