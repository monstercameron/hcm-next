{
  "schemaVersion": "v0.4",
  "metadata": {
    "schemaVersion": "v0.4",
    "title": "Employee compensation change",
    "description": "HR-initiated compensation change with compensation approval, vendor decision routing, and repair handling.",
    "domain": "worker",
    "owner": "hcm-workflow-platform",
    "tags": ["worker", "employee_compensation_change"],
    "deterministicBlockRefs": {
      "preflight": {
        "name": "system.employee_data.compensation.preflight",
        "version": "1.0.0",
        "runtime": "go"
      },
      "planTransaction": {
        "name": "system.employee_data.compensation.plan_transaction",
        "version": "1.0.0",
        "runtime": "go"
      }
    }
  },
  "intent": "employee.compensation.change",
  "subjectType": "worker",
  "selfServiceStart": false,
  "startActors": ["hr_admin"],
  "ui": {
    "defaultInteraction": "input",
    "stateInteractions": {
      "collecting_input": "input",
      "waiting_approval": "waitingApproval",
      "approved": "readyToExecute",
      "waiting_repair": "vendorDecisionRepair"
    }
  },
  "interactions": {
    "input": {
      "type": "form",
      "schemaVersion": "v0.2",
      "title": "Request compensation change",
      "employeeContext": [
        {
          "outputKey": "currentCompensation",
          "path": "compensation"
        },
        {
          "outputKey": "currentJob",
          "path": "job"
        },
        {
          "outputKey": "currentOrganization",
          "path": "organization"
        }
      ],
      "jsonSchema": {
        "type": "object",
        "required": ["proposedCompensation", "effectiveAt", "businessReason"],
        "properties": {
          "proposedCompensation": {
            "type": "object",
            "required": [
              "amount",
              "currency",
              "payFrequency",
              "bonusTargetPercent",
              "effectiveDate"
            ],
            "properties": {
              "amount": {
                "type": "number",
                "minimum": 1
              },
              "currency": {
                "type": "string",
                "minLength": 3,
                "maxLength": 3
              },
              "payFrequency": {
                "type": "string",
                "enum": ["annual", "hourly", "monthly"]
              },
              "bonusTargetPercent": {
                "type": "number",
                "minimum": 0
              },
              "effectiveDate": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "effectiveAt": {
            "type": "string",
            "format": "date"
          },
          "businessReason": {
            "type": "string",
            "enum": [
              "merit_increase",
              "promotion",
              "retention_adjustment",
              "market_adjustment",
              "correction"
            ]
          }
        }
      },
      "uiSchema": {
        "layout": "sectioned_form",
        "submitLabel": "Submit for compensation review"
      }
    },
    "waitingApproval": {
      "type": "waiting",
      "title": "Waiting for compensation approval"
    },
    "readyToExecute": {
      "type": "ready_to_execute",
      "title": "Ready to execute compensation change"
    },
    "vendorDecisionRepair": {
      "type": "repair",
      "title": "Vendor compensation decision needs repair",
      "jsonSchema": {
        "type": "object",
        "required": ["repairAction"],
        "properties": {
          "repairAction": {
            "type": "string",
            "enum": ["revise_compensation", "cancel_request", "manual_review"]
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "uiSchema": {
        "layout": "repair_panel",
        "submitLabel": "Record repair action"
      }
    }
  },
  "states": {
    "collecting_input": {
      "actions": [
        {
          "transition": "submit_input",
          "label": "Submit for compensation review",
          "actor": "initiator",
          "handler": "submit_configured_input",
          "nextState": "waiting_approval",
          "nextStatus": "waiting",
          "nextInteraction": "waitingApproval"
        },
        {
          "transition": "cancel",
          "label": "Cancel",
          "actor": "initiator",
          "handler": "cancel"
        }
      ]
    },
    "waiting_approval": {
      "actions": [
        {
          "transition": "approve",
          "label": "Approve",
          "actor": "compensation_admin",
          "handler": "approve"
        },
        {
          "transition": "reject",
          "label": "Reject",
          "actor": "compensation_admin",
          "handler": "reject"
        },
        {
          "transition": "cancel",
          "label": "Cancel request",
          "actor": "initiator",
          "handler": "cancel"
        }
      ]
    },
    "approved": {
      "actions": [
        {
          "transition": "execute",
          "label": "Execute compensation change",
          "actor": "hr_admin_or_system",
          "handler": "execute"
        }
      ]
    },
    "waiting_repair": {
      "actions": [
        {
          "transition": "cancel",
          "label": "Cancel request",
          "actor": "hr_admin",
          "handler": "cancel"
        }
      ]
    }
  },
  "submit": {
    "preflightBlock": {
      "name": "system.employee_data.compensation.preflight",
      "version": "1.0.0",
      "runtime": "go"
    },
    "preflightInput": {
      "currentCompensation": {
        "$source": "employee",
        "path": "compensation"
      },
      "proposedCompensation": {
        "$source": "input",
        "path": "proposedCompensation"
      },
      "currentJob": {
        "$source": "employee",
        "path": "job"
      },
      "currentOrganization": {
        "$source": "employee",
        "path": "organization"
      },
      "effectiveAt": {
        "$source": "input",
        "path": "effectiveAt"
      },
      "businessReason": {
        "$source": "input",
        "path": "businessReason"
      }
    },
    "effectiveAt": {
      "$source": "input",
      "path": "effectiveAt"
    },
    "businessReason": {
      "$source": "input",
      "path": "businessReason"
    },
    "changeRequestStatus": "in_approval",
    "markSubmitted": true,
    "createApprovalTask": true,
    "currentSnapshot": {
      "compensation": {
        "$source": "employee",
        "path": "compensation"
      },
      "job": {
        "$source": "employee",
        "path": "job"
      },
      "organization": {
        "$source": "employee",
        "path": "organization"
      }
    },
    "proposedSnapshot": {
      "compensation": {
        "$source": "input",
        "path": "proposedCompensation"
      }
    },
    "proposedChange": {
      "targetObjectType": "worker",
      "targetObjectId": {
        "$source": "workflow",
        "path": "subjectId"
      },
      "fieldPath": "compensation",
      "currentValue": {
        "$source": "employee",
        "path": "compensation"
      },
      "proposedValue": {
        "$source": "input",
        "path": "proposedCompensation"
      }
    },
    "additionalEvents": [
      "ProposedChangeCreated",
      "CompensationPreflighted",
      "ApprovalTaskCreated",
      "ChangeRequestSubmitted"
    ]
  },
  "approval": {
    "assigneeActorId": "actor_comp_admin",
    "assigneeRole": "compensation_admin",
    "approvalType": "compensation_change_review"
  },
  "plan": {
    "block": {
      "name": "system.employee_data.compensation.plan_transaction",
      "version": "1.0.0",
      "runtime": "go"
    },
    "input": {
      "changeRequestId": {
        "$source": "changeRequest",
        "path": "changeRequestId"
      },
      "workerId": {
        "$source": "workflow",
        "path": "subjectId"
      },
      "currentCompensation": {
        "$source": "employee",
        "path": "compensation"
      },
      "proposedCompensation": {
        "$source": "proposedChange",
        "path": "proposedValue"
      },
      "effectiveAt": {
        "$source": "changeRequest",
        "path": "effectiveAt"
      },
      "businessReason": {
        "$source": "changeRequest",
        "path": "businessReason"
      }
    }
  },
  "graph": {
    "startNodeId": "collect_compensation_input",
    "nodes": [
      {
        "nodeId": "collect_compensation_input",
        "type": "interaction",
        "title": "Collect compensation input",
        "state": "collecting_input",
        "outcomes": [
          {
            "outcome": "submitted",
            "nextNodeId": "compensation_preflight",
            "nextState": "waiting_approval",
            "nextStatus": "waiting",
            "routeKey": "submitted"
          },
          {
            "outcome": "canceled",
            "nextNodeId": "canceled",
            "nextState": "canceled",
            "nextStatus": "canceled",
            "routeKey": "canceled"
          }
        ],
        "interaction": "input"
      },
      {
        "nodeId": "compensation_preflight",
        "type": "block",
        "title": "Run compensation preflight",
        "outcomes": [
          {
            "outcome": "valid",
            "nextNodeId": "compensation_approval",
            "eventType": "CompensationPreflighted",
            "routeKey": "valid"
          },
          {
            "outcome": "invalid",
            "nextNodeId": "collect_compensation_input",
            "eventType": "CompensationPreflighted",
            "nextState": "collecting_input",
            "nextStatus": "active",
            "routeKey": "invalid"
          }
        ],
        "block": {
          "name": "system.employee_data.compensation.preflight",
          "version": "1.0.0",
          "runtime": "go"
        },
        "blockInput": {
          "currentCompensation": {
            "$source": "employee",
            "path": "compensation"
          },
          "proposedCompensation": {
            "$source": "input",
            "path": "proposedCompensation"
          },
          "currentJob": {
            "$source": "employee",
            "path": "job"
          },
          "currentOrganization": {
            "$source": "employee",
            "path": "organization"
          },
          "effectiveAt": {
            "$source": "input",
            "path": "effectiveAt"
          },
          "businessReason": {
            "$source": "input",
            "path": "businessReason"
          }
        }
      },
      {
        "nodeId": "compensation_approval",
        "type": "approval",
        "title": "Compensation approval",
        "state": "waiting_approval",
        "outcomes": [
          {
            "outcome": "approved",
            "nextNodeId": "plan_compensation_transaction",
            "nextState": "approved",
            "nextStatus": "active",
            "eventType": "ApprovalGranted",
            "routeKey": "approved"
          },
          {
            "outcome": "rejected",
            "nextNodeId": "rejected",
            "nextState": "rejected",
            "nextStatus": "rejected",
            "eventType": "ApprovalRejected",
            "routeKey": "rejected"
          }
        ],
        "approval": {
          "taskKey": "compensation_approval",
          "approvalType": "compensation_approval_review",
          "resolver": {
            "type": "role",
            "role": "compensation_admin",
            "permission": "employee_data_change.compensation.approve"
          },
          "decisionSchema": {
            "approve": {
              "required": []
            },
            "reject": {
              "required": ["reason"]
            },
            "requestMoreInfo": {
              "required": ["reason"]
            }
          }
        }
      },
      {
        "nodeId": "plan_compensation_transaction",
        "type": "transaction_plan",
        "title": "Plan compensation transaction",
        "outcomes": [
          {
            "outcome": "planned",
            "nextNodeId": "vendor_compensation_decision",
            "eventType": "TransactionPlanCreated",
            "routeKey": "planned"
          }
        ],
        "block": {
          "name": "system.employee_data.compensation.plan_transaction",
          "version": "1.0.0",
          "runtime": "go"
        },
        "blockInput": {
          "changeRequestId": {
            "$source": "changeRequest",
            "path": "changeRequestId"
          },
          "workerId": {
            "$source": "workflow",
            "path": "subjectId"
          },
          "currentCompensation": {
            "$source": "employee",
            "path": "compensation"
          },
          "proposedCompensation": {
            "$source": "proposedChange",
            "path": "proposedValue"
          },
          "effectiveAt": {
            "$source": "changeRequest",
            "path": "effectiveAt"
          },
          "businessReason": {
            "$source": "changeRequest",
            "path": "businessReason"
          }
        }
      },
      {
        "nodeId": "vendor_compensation_decision",
        "type": "external_write",
        "title": "Submit compensation decision to vendor",
        "connectionId": "third_party_compensation_decision",
        "operation": "submitCompensationChange",
        "outcomes": [
          {
            "outcome": "accepted",
            "when": {
              "$source": "externalWriteResponse",
              "path": "status",
              "equals": "accepted"
            },
            "eventType": "ExternalWriteSucceeded",
            "nextNodeId": "apply_compensation_projection",
            "routeKey": "accepted"
          },
          {
            "outcome": "rejected",
            "when": {
              "$source": "externalWriteResponse",
              "path": "status",
              "equals": "rejected"
            },
            "eventType": "ExternalWriteFailed",
            "nextNodeId": "repair_vendor_decision",
            "nextState": "waiting_repair",
            "nextStatus": "waiting_repair",
            "nextInteraction": "vendorDecisionRepair",
            "routeKey": "rejected"
          },
          {
            "outcome": "retryable_failure",
            "when": {
              "$source": "externalWriteError",
              "path": "category",
              "in": ["timeout", "rate_limited", "transient_5xx"]
            },
            "eventType": "ExternalWriteFailed",
            "nextNodeId": "repair_vendor_decision",
            "nextState": "waiting_repair",
            "nextStatus": "waiting_repair",
            "nextInteraction": "vendorDecisionRepair",
            "routeKey": "retryable_failure"
          }
        ],
        "transaction": {
          "sideEffect": true,
          "idempotency": {
            "scope": "node",
            "keyTemplate": "compensation_vendor_decision.${transactionPlan.transactionPlanId}",
            "onDuplicate": "read_existing_result"
          },
          "reversibility": "manual_repair",
          "retryPolicy": {
            "maxAttempts": 3,
            "backoff": "exponential",
            "retryOn": ["timeout", "rate_limited", "transient_5xx"]
          },
          "failurePolicy": {
            "onFailure": "retry_then_repair",
            "retryPolicy": {
              "maxAttempts": 3,
              "backoff": "exponential",
              "retryOn": ["timeout", "rate_limited", "transient_5xx"]
            },
            "afterRetriesExhausted": {
              "runCompensation": true,
              "nextNodeId": "repair_vendor_decision",
              "nextState": "waiting_repair",
              "nextStatus": "waiting_repair",
              "nextInteraction": "vendorDecisionRepair",
              "eventType": "WorkflowFailed"
            }
          },
          "reconciliation": {
            "required": true,
            "expected": {
              "status": "accepted"
            },
            "onMismatch": {
              "nextNodeId": "repair_vendor_decision",
              "nextState": "waiting_repair",
              "nextStatus": "waiting_repair",
              "nextInteraction": "vendorDecisionRepair",
              "eventType": "ExternalWriteFailed"
            }
          },
          "idempotencyKeyPath": "transactionPlan.idempotencyKey"
        }
      },
      {
        "nodeId": "apply_compensation_projection",
        "type": "projection_write",
        "title": "Apply accepted compensation change",
        "outcomes": [
          {
            "outcome": "applied",
            "eventType": "EmployeeCompensationUpdated",
            "nextNodeId": "completed",
            "routeKey": "applied"
          }
        ],
        "transaction": {
          "sideEffect": true,
          "idempotency": {
            "scope": "node",
            "keyTemplate": "compensation_projection.${workflow.workflowInstanceId}",
            "onDuplicate": "read_existing_result"
          },
          "reversibility": "compensatable",
          "retryPolicy": {
            "maxAttempts": 3,
            "backoff": "exponential",
            "retryOn": ["timeout", "rate_limited", "transient_5xx"]
          },
          "failurePolicy": {
            "onFailure": "retry_then_compensate",
            "retryPolicy": {
              "maxAttempts": 3,
              "backoff": "exponential",
              "retryOn": ["timeout", "rate_limited", "transient_5xx"]
            },
            "afterRetriesExhausted": {
              "runCompensation": true,
              "nextNodeId": "repair_vendor_decision",
              "nextState": "waiting_repair",
              "nextStatus": "waiting_repair",
              "nextInteraction": "vendorDecisionRepair",
              "eventType": "WorkflowFailed"
            }
          }
        }
      },
      {
        "nodeId": "repair_vendor_decision",
        "type": "manual_repair",
        "title": "Repair rejected vendor decision",
        "state": "waiting_repair",
        "outcomes": [
          {
            "outcome": "canceled",
            "nextNodeId": "canceled",
            "nextState": "canceled",
            "nextStatus": "canceled",
            "routeKey": "canceled"
          }
        ]
      },
      {
        "nodeId": "completed",
        "type": "terminal",
        "title": "Compensation workflow completed",
        "state": "executed"
      },
      {
        "nodeId": "canceled",
        "type": "terminal",
        "title": "Compensation workflow canceled",
        "state": "canceled"
      },
      {
        "nodeId": "rejected",
        "type": "terminal",
        "title": "Compensation workflow rejected",
        "state": "rejected"
      }
    ],
    "edges": [
      {
        "edgeId": "collect_compensation_input.submitted",
        "fromNodeId": "collect_compensation_input",
        "routeKey": "submitted",
        "toNodeId": "compensation_preflight",
        "nextState": "waiting_approval",
        "nextStatus": "waiting"
      },
      {
        "edgeId": "collect_compensation_input.canceled",
        "fromNodeId": "collect_compensation_input",
        "routeKey": "canceled",
        "toNodeId": "canceled",
        "nextState": "canceled",
        "nextStatus": "canceled"
      },
      {
        "edgeId": "compensation_preflight.valid",
        "fromNodeId": "compensation_preflight",
        "routeKey": "valid",
        "toNodeId": "compensation_approval",
        "eventType": "CompensationPreflighted"
      },
      {
        "edgeId": "compensation_preflight.invalid",
        "fromNodeId": "compensation_preflight",
        "routeKey": "invalid",
        "toNodeId": "collect_compensation_input",
        "eventType": "CompensationPreflighted",
        "nextState": "collecting_input",
        "nextStatus": "active"
      },
      {
        "edgeId": "compensation_approval.approved",
        "fromNodeId": "compensation_approval",
        "routeKey": "approved",
        "toNodeId": "plan_compensation_transaction",
        "eventType": "ApprovalGranted",
        "nextState": "approved",
        "nextStatus": "active"
      },
      {
        "edgeId": "compensation_approval.rejected",
        "fromNodeId": "compensation_approval",
        "routeKey": "rejected",
        "toNodeId": "rejected",
        "eventType": "ApprovalRejected",
        "nextState": "rejected",
        "nextStatus": "rejected"
      },
      {
        "edgeId": "plan_compensation_transaction.planned",
        "fromNodeId": "plan_compensation_transaction",
        "routeKey": "planned",
        "toNodeId": "vendor_compensation_decision",
        "eventType": "TransactionPlanCreated"
      },
      {
        "edgeId": "vendor_compensation_decision.accepted",
        "fromNodeId": "vendor_compensation_decision",
        "routeKey": "accepted",
        "toNodeId": "apply_compensation_projection",
        "eventType": "ExternalWriteSucceeded"
      },
      {
        "edgeId": "vendor_compensation_decision.rejected",
        "fromNodeId": "vendor_compensation_decision",
        "routeKey": "rejected",
        "toNodeId": "repair_vendor_decision",
        "eventType": "ExternalWriteFailed",
        "nextState": "waiting_repair",
        "nextStatus": "waiting_repair",
        "nextInteraction": "vendorDecisionRepair"
      },
      {
        "edgeId": "vendor_compensation_decision.retryable_failure",
        "fromNodeId": "vendor_compensation_decision",
        "routeKey": "retryable_failure",
        "toNodeId": "repair_vendor_decision",
        "eventType": "ExternalWriteFailed",
        "nextState": "waiting_repair",
        "nextStatus": "waiting_repair",
        "nextInteraction": "vendorDecisionRepair"
      },
      {
        "edgeId": "apply_compensation_projection.applied",
        "fromNodeId": "apply_compensation_projection",
        "routeKey": "applied",
        "toNodeId": "completed",
        "eventType": "EmployeeCompensationUpdated"
      },
      {
        "edgeId": "repair_vendor_decision.canceled",
        "fromNodeId": "repair_vendor_decision",
        "routeKey": "canceled",
        "toNodeId": "canceled",
        "nextState": "canceled",
        "nextStatus": "canceled"
      }
    ]
  },
  "saga": {
    "mode": "orchestrated",
    "transactionBoundary": "workflow_instance",
    "failurePolicy": "compensate_then_repair",
    "idempotencyScope": "workflow_instance",
    "compensationOrder": "reverse_completed_steps",
    "reconciliationRequired": true
  },
