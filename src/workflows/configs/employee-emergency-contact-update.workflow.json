{
  "schemaVersion": "v0.4",
  "metadata": {
    "schemaVersion": "v0.4",
    "title": "Employee emergency contact update",
    "description": "Self-service emergency contact update with HR approval and deterministic HRIS transaction planning.",
    "domain": "worker",
    "owner": "hcm-workflow-platform",
    "tags": ["worker", "employee_emergency_contact_update"],
    "deterministicBlockRefs": {
      "preflight": {
        "name": "system.employee_data.emergency_contact.preflight",
        "version": "1.0.0",
        "runtime": "go"
      },
      "planTransaction": {
        "name": "system.employee_data.emergency_contact.plan_transaction",
        "version": "1.0.0",
        "runtime": "go"
      }
    }
  },
  "intent": "employee.emergency_contact.update",
  "subjectType": "worker",
  "selfServiceStart": true,
  "ui": {
    "defaultInteraction": "input",
    "stateInteractions": {
      "collecting_input": "input",
      "waiting_approval": "waitingApproval",
      "approved": "readyToExecute"
    }
  },
  "interactions": {
    "input": {
      "type": "form",
      "schemaVersion": "v0.2",
      "title": "Update emergency contact",
      "employeeContext": [
        {
          "outputKey": "currentEmergencyContacts",
          "path": "emergencyContacts"
        }
      ],
      "jsonSchema": {
        "type": "object",
        "required": ["proposedEmergencyContact", "effectiveAt", "businessReason"],
        "properties": {
          "proposedEmergencyContact": {
            "type": "object",
            "required": ["name", "relationship", "phone", "priority"],
            "properties": {
              "contactId": {
                "type": "string"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "relationship": {
                "type": "string",
                "enum": [
                  "spouse",
                  "partner",
                  "parent",
                  "sibling",
                  "child",
                  "friend",
                  "other"
                ]
              },
              "phone": {
                "type": "string",
                "minLength": 7
              },
              "email": {
                "type": ["string", "null"]
              },
              "priority": {
                "type": "number",
                "minimum": 1
              }
            }
          },
          "effectiveAt": {
            "type": "string",
            "format": "date"
          },
          "businessReason": {
            "type": "string",
            "enum": ["employee_self_service", "correction", "annual_review", "other"]
          }
        }
      },
      "uiSchema": {
        "layout": "single_page",
        "submitLabel": "Submit for review"
      }
    },
    "waitingApproval": {
      "type": "waiting",
      "title": "Waiting for HR approval"
    },
    "readyToExecute": {
      "type": "ready_to_execute",
      "title": "Ready to execute emergency contact update"
    }
  },
  "states": {
    "collecting_input": {
      "actions": [
        {
          "transition": "submit_input",
          "label": "Submit for review",
          "actor": "requester",
          "handler": "submit_configured_input",
          "nextState": "waiting_approval",
          "nextStatus": "waiting",
          "nextInteraction": "waitingApproval"
        },
        {
          "transition": "cancel",
          "label": "Cancel",
          "actor": "requester",
          "handler": "cancel"
        }
      ]
    },
    "waiting_approval": {
      "actions": [
        {
          "transition": "approve",
          "label": "Approve",
          "actor": "hr_admin",
          "handler": "approve"
        },
        {
          "transition": "reject",
          "label": "Reject",
          "actor": "hr_admin",
          "handler": "reject"
        },
        {
          "transition": "cancel",
          "label": "Cancel request",
          "actor": "requester",
          "handler": "cancel"
        }
      ]
    },
    "approved": {
      "actions": [
        {
          "transition": "execute",
          "label": "Execute change",
          "actor": "hr_admin_or_system",
          "handler": "execute"
        }
      ]
    }
  },
  "submit": {
    "preflightBlock": {
      "name": "system.employee_data.emergency_contact.preflight",
      "version": "1.0.0",
      "runtime": "go"
    },
    "preflightInput": {
      "currentEmergencyContacts": {
        "$source": "employee",
        "path": "emergencyContacts"
      },
      "proposedEmergencyContact": {
        "$source": "input",
        "path": "proposedEmergencyContact"
      },
      "effectiveAt": {
        "$source": "input",
        "path": "effectiveAt"
      },
      "businessReason": {
        "$source": "input",
        "path": "businessReason"
      }
    },
    "effectiveAt": {
      "$source": "input",
      "path": "effectiveAt"
    },
    "businessReason": {
      "$source": "input",
      "path": "businessReason"
    },
    "changeRequestStatus": "in_approval",
    "markSubmitted": true,
    "createApprovalTask": true,
    "currentSnapshot": {
      "emergencyContacts": {
        "$source": "employee",
        "path": "emergencyContacts"
      }
    },
    "proposedSnapshot": {
      "emergencyContact": {
        "$source": "input",
        "path": "proposedEmergencyContact"
      }
    },
    "proposedChange": {
      "targetObjectType": "worker",
      "targetObjectId": {
        "$source": "workflow",
        "path": "subjectId"
      },
      "fieldPathTemplate": "emergencyContacts.${proposedEmergencyContact.contactId}",
      "currentValue": {
        "$source": "employee",
        "path": "emergencyContacts"
      },
      "proposedValue": {
        "$source": "input",
        "path": "proposedEmergencyContact"
      }
    },
    "additionalEvents": [
      "ProposedChangeCreated",
      "EmergencyContactPreflighted",
      "ApprovalTaskCreated",
      "ChangeRequestSubmitted"
    ]
  },
  "approval": {
    "assigneeActorId": "actor_hr_admin",
    "assigneeRole": "hr_admin",
    "approvalType": "hr_emergency_contact_review"
  },
  "plan": {
    "block": {
      "name": "system.employee_data.emergency_contact.plan_transaction",
      "version": "1.0.0",
      "runtime": "go"
    },
    "input": {
      "changeRequestId": {
        "$source": "changeRequest",
        "path": "changeRequestId"
      },
      "workerId": {
        "$source": "workflow",
        "path": "subjectId"
      },
      "currentEmergencyContacts": {
        "$source": "employee",
        "path": "emergencyContacts"
      },
      "proposedEmergencyContact": {
        "$source": "proposedChange",
        "path": "proposedValue"
      },
      "effectiveAt": {
        "$source": "changeRequest",
        "path": "effectiveAt"
      }
    }
  },
  "graph": {
    "startNodeId": "collect_emergency_contact_input",
    "metadata": {
      "executionModel": "generic_graph",
      "compatibility": "legacy_submit_approval_execute"
    },
    "nodes": [
      {
        "nodeId": "collect_emergency_contact_input",
        "type": "interaction",
        "title": "Collect emergency contact update input",
        "state": "collecting_input",
        "interaction": "input",
        "outcomes": [
          {
            "outcome": "submitted",
            "eventType": "ChangeRequestCreated",
            "nextNodeId": "emergency_contact_preflight",
            "routeKey": "submitted"
          },
          {
            "outcome": "canceled",
            "eventType": "WorkflowCanceled",
            "nextNodeId": "canceled",
            "nextState": "canceled",
            "nextStatus": "canceled",
            "routeKey": "canceled"
          }
        ]
      },
      {
        "nodeId": "emergency_contact_preflight",
        "type": "block",
        "title": "Run emergency contact update preflight",
        "block": {
          "name": "system.employee_data.emergency_contact.preflight",
          "version": "1.0.0",
          "runtime": "go"
        },
        "blockInput": {
          "currentEmergencyContacts": {
            "$source": "employee",
            "path": "emergencyContacts"
          },
          "proposedEmergencyContact": {
            "$source": "input",
            "path": "proposedEmergencyContact"
          },
          "effectiveAt": {
            "$source": "input",
            "path": "effectiveAt"
          },
          "businessReason": {
            "$source": "input",
            "path": "businessReason"
          }
        },
        "outcomes": [
          {
            "outcome": "valid",
            "eventType": "EmergencyContactPreflighted",
            "nextNodeId": "hr_emergency_contact_approval",
            "nextState": "waiting_approval",
            "nextStatus": "waiting",
            "nextInteraction": "waitingApproval",
            "routeKey": "valid"
          },
          {
            "outcome": "invalid",
            "eventType": "EmergencyContactPreflighted",
            "nextNodeId": "collect_emergency_contact_input",
            "nextState": "collecting_input",
            "nextStatus": "active",
            "nextInteraction": "input",
            "routeKey": "invalid"
          }
        ]
      },
      {
        "nodeId": "hr_emergency_contact_approval",
        "type": "approval",
        "title": "HR emergency contact update approval",
        "state": "waiting_approval",
        "interaction": "waitingApproval",
        "approval": {
          "taskKey": "hr_emergency_contact_review",
          "approvalType": "hr_emergency_contact_review",
          "interaction": "waitingApproval",
          "resolver": {
            "type": "role",
            "role": "hr_admin",
            "permission": "employee_data_change.emergency_contact.approve"
          },
          "decisionSchema": {
            "approve": {
              "required": []
            },
            "reject": {
              "required": ["reason"]
            },
            "requestMoreInfo": {
              "required": ["reason"]
            }
          }
        },
        "outcomes": [
          {
            "outcome": "approved",
            "eventType": "ApprovalGranted",
            "nextNodeId": "plan_emergency_contact_transaction",
            "nextState": "approved",
            "nextStatus": "active",
            "nextInteraction": "readyToExecute",
            "routeKey": "approved"
          },
          {
            "outcome": "rejected",
            "eventType": "ApprovalRejected",
            "nextNodeId": "rejected",
            "nextState": "rejected",
            "nextStatus": "rejected",
            "routeKey": "rejected"
          }
        ]
      },
      {
        "nodeId": "plan_emergency_contact_transaction",
        "type": "transaction_plan",
        "title": "Plan emergency contact update transaction",
        "block": {
          "name": "system.employee_data.emergency_contact.plan_transaction",
          "version": "1.0.0",
          "runtime": "go"
        },
        "blockInput": {
          "changeRequestId": {
            "$source": "changeRequest",
            "path": "changeRequestId"
          },
          "workerId": {
            "$source": "workflow",
            "path": "subjectId"
          },
          "currentEmergencyContacts": {
            "$source": "employee",
            "path": "emergencyContacts"
          },
          "proposedEmergencyContact": {
            "$source": "proposedChange",
            "path": "proposedValue"
          },
          "effectiveAt": {
            "$source": "changeRequest",
            "path": "effectiveAt"
          }
        },
        "outcomes": [
          {
            "outcome": "planned",
            "eventType": "TransactionPlanCreated",
            "nextNodeId": "apply_emergency_contact_projection",
            "routeKey": "planned"
          },
          {
            "outcome": "failed",
            "eventType": "WorkflowFailed",
            "nextNodeId": "failed",
            "nextState": "failed",
            "nextStatus": "failed",
            "routeKey": "failed"
          }
        ]
      },
      {
        "nodeId": "apply_emergency_contact_projection",
        "type": "projection_write",
        "title": "Apply emergency contact update projection",
        "transaction": {
          "sideEffect": true,
          "idempotency": {
            "scope": "node",
            "keyTemplate": "emergency_contact_projection.${workflow.workflowInstanceId}",
            "onDuplicate": "read_existing_result"
          },
          "reversibility": "compensatable",
          "retryPolicy": {
            "maxAttempts": 3,
            "backoff": "exponential",
            "retryOn": ["timeout", "rate_limited", "transient_5xx"]
          },
          "failurePolicy": {
            "onFailure": "retry_then_compensate",
            "retryPolicy": {
              "maxAttempts": 3,
              "backoff": "exponential",
              "retryOn": ["timeout", "rate_limited", "transient_5xx"]
            },
            "afterRetriesExhausted": {
              "runCompensation": true,
              "nextNodeId": "failed",
              "nextState": "failed",
              "nextStatus": "failed",
              "eventType": "WorkflowFailed"
            }
          }
        },
        "outcomes": [
          {
            "outcome": "applied",
            "eventType": "EmployeeEmergencyContactUpdated",
            "nextNodeId": "record_emergency_contact_projection_update",
            "routeKey": "applied"
          },
          {
            "outcome": "failed",
            "eventType": "WorkflowFailed",
            "nextNodeId": "failed",
            "nextState": "failed",
            "nextStatus": "failed",
            "routeKey": "failed"
          }
        ]
      },
      {
        "nodeId": "record_emergency_contact_projection_update",
        "type": "ledger_event",
        "title": "Record employee projection update",
        "outcomes": [
          {
            "outcome": "recorded",
            "eventType": "EmployeeProjectionUpdated",
            "nextNodeId": "sync_emergency_contact_hris",
            "routeKey": "recorded"
          }
        ]
      },
      {
        "nodeId": "sync_emergency_contact_hris",
        "type": "external_write",
        "title": "Queue emergency contact update HRIS sync",
        "connectionId": "fake_hris",
        "operation": "updateEmergencyContacts",
        "transaction": {
          "sideEffect": true,
          "idempotency": {
            "scope": "node",
            "keyTemplate": "emergency_contact_hris.${workflow.workflowInstanceId}",
            "onDuplicate": "read_existing_result"
          },
          "reversibility": "manual_repair",
          "retryPolicy": {
            "maxAttempts": 3,
            "backoff": "exponential",
            "retryOn": ["timeout", "rate_limited", "transient_5xx"]
          },
          "failurePolicy": {
            "onFailure": "retry_then_repair",
            "retryPolicy": {
              "maxAttempts": 3,
              "backoff": "exponential",
              "retryOn": ["timeout", "rate_limited", "transient_5xx"]
            },
            "afterRetriesExhausted": {
              "runCompensation": true,
              "nextNodeId": "failed",
              "nextState": "failed",
              "nextStatus": "failed",
              "eventType": "WorkflowFailed"
            }
          },
          "idempotencyKeyPath": "transactionPlan.idempotencyKey"
        },
        "outcomes": [
          {
            "outcome": "requested",
            "eventType": "ExternalWriteRequested",
            "nextNodeId": "completed",
            "routeKey": "requested"
          },
          {
            "outcome": "retryable_failure",
            "eventType": "ExternalWriteFailed",
            "nextNodeId": "failed",
            "nextState": "failed",
            "nextStatus": "failed",
            "routeKey": "retryable_failure"
          }
        ]
      },
      {
        "nodeId": "completed",
        "type": "terminal",
        "title": "Emergency contact update workflow completed",
        "state": "executed"
