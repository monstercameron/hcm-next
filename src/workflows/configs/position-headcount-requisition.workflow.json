      "uiSchema": {
        "layout": "wizard",
        "fieldLabels": {
          "department": "Department",
          "team": "Team",
          "location": "Location",
          "costCenter": "Cost center",
          "jobCode": "Job code",
          "title": "Title",
          "level": "Level",
          "requestedFte": "Requested FTE",
          "targetStartDate": "Target start date",
