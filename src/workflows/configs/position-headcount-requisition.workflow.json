          "department",
          "team",
          "location",
          "costCenter",
          "jobCode",
          "title",
          "level",
          "requestedFte",
          "targetStartDate",
          "salaryRangeMin",
          "salaryRangeMax",
          "businessJustification",
          "selectedLeadershipApprovers"
