        "properties": {
          "department": {
            "type": "string",
            "minLength": 1
          },
          "team": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "costCenter": {
            "type": "string",
            "minLength": 1
          },
          "jobCode": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "string",
            "minLength": 1
          },
          "requestedFte": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "targetStartDate": {
            "type": "string",
            "format": "date"
          },
          "salaryRangeMin": {
            "type": "number"
          },
          "salaryRangeMax": {
            "type": "number"
          },
          "businessJustification": {
            "type": "string",
            "minLength": 1
          },
          "selectedLeadershipApprovers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
