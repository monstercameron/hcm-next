{
  "schemaVersion": "v0.4",
  "metadata": {
    "schemaVersion": "v0.4",
    "title": "Employee legal name change",
    "description": "Self-service legal name change with HR evidence review and deterministic HRIS transaction planning.",
    "domain": "worker",
    "owner": "hcm-workflow-platform",
    "tags": ["worker", "employee_legal_name_change"],
    "deterministicBlockRefs": {
      "preflight": {
        "name": "system.employee_data.legal_name.preflight",
        "version": "1.0.0",
        "runtime": "go"
      },
      "planTransaction": {
        "name": "system.employee_data.legal_name.plan_transaction",
        "version": "1.0.0",
        "runtime": "go"
      }
    }
  },
  "intent": "employee.legal_name.change",
  "subjectType": "worker",
  "selfServiceStart": true,
  "ui": {
    "defaultInteraction": "input",
    "stateInteractions": {
      "collecting_input": "input",
      "collecting_evidence": "evidence",
      "waiting_approval": "waitingApproval",
      "approved": "readyToExecute"
    }
  },
  "interactions": {
    "input": {
      "type": "form",
      "schemaVersion": "v0.2",
      "title": "Request legal name change",
      "employeeContext": [
        {
          "outputKey": "currentLegalName",
          "path": "person.legalName"
        }
      ],
      "jsonSchema": {
        "type": "object",
        "required": ["newLegalName", "effectiveAt", "businessReason"],
        "properties": {
          "newLegalName": {
            "type": "object",
            "required": ["first", "last"],
            "properties": {
              "first": {
                "type": "string",
                "minLength": 1
              },
              "middle": {
                "type": ["string", "null"]
              },
              "last": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "effectiveAt": {
            "type": "string",
            "format": "date"
          },
          "businessReason": {
            "type": "string",
            "enum": ["marriage", "divorce", "legal_name_change", "correction", "other"]
          }
        }
      },
      "uiSchema": {
        "layout": "wizard",
        "submitLabel": "Continue"
      }
    },
    "evidence": {
      "type": "evidence_upload",
      "title": "Upload legal name change evidence",
      "acceptedDocumentTypes": [
        "marriage_certificate",
        "court_order",
        "government_id",
        "other_legal_document"
      ],
      "maxFiles": 1
    },
    "waitingApproval": {
      "type": "waiting",
      "title": "Waiting for HR approval"
    },
    "readyToExecute": {
      "type": "ready_to_execute",
      "title": "Ready to execute legal name change"
    }
  },
  "states": {
    "collecting_input": {
      "actions": [
        {
          "transition": "submit_input",
          "label": "Continue",
          "actor": "requester",
          "handler": "submit_configured_input",
          "nextState": "collecting_evidence",
          "nextStatus": "active",
          "nextInteraction": "evidence"
        },
        {
          "transition": "cancel",
          "label": "Cancel",
          "actor": "requester",
          "handler": "cancel"
        }
      ]
    },
    "collecting_evidence": {
      "actions": [
        {
          "transition": "provide_evidence",
          "label": "Submit evidence",
          "actor": "requester",
          "handler": "provide_evidence",
          "nextState": "waiting_approval",
          "nextStatus": "waiting",
          "nextInteraction": "waitingApproval"
        },
        {
          "transition": "cancel",
          "label": "Cancel request",
          "actor": "requester",
          "handler": "cancel"
        }
      ]
    },
    "waiting_approval": {
      "actions": [
        {
          "transition": "approve",
          "label": "Approve",
          "actor": "hr_admin",
          "handler": "approve"
        },
        {
          "transition": "reject",
          "label": "Reject",
          "actor": "hr_admin",
          "handler": "reject"
        },
        {
          "transition": "request_more_info",
          "label": "Request more information",
          "actor": "hr_admin",
          "handler": "request_more_info",
          "nextState": "collecting_evidence",
          "nextStatus": "active",
          "nextInteraction": "evidence"
        },
        {
          "transition": "cancel",
          "label": "Cancel request",
          "actor": "requester",
          "handler": "cancel"
        }
      ]
    },
    "approved": {
      "actions": [
        {
          "transition": "execute",
          "label": "Execute change",
          "actor": "hr_admin_or_system",
          "handler": "execute"
        }
      ]
    }
  },
