{
  "name": "hcm-next",
  "version": "0.1.0",
  "private": true,
  "description": "Workflow-native HCM platform foundation.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "src/api",
    "src/platform/*",
    "src/third-party-apis/*"
  ],
  "scripts": {
    "dev": "npm --workspace @hcm-next/api run dev",
    "dev:frontend": "go run ./cmd/frontenddev",
    "dev:blocks": "cd src/blocks/go && go run ./cmd/executor",
    "dev:executor": "npm run dev:blocks",
    "dev:third-party:compensation": "npm --workspace @hcm-next/third-party-compensation-market-api run dev",
    "dev:third-party:compensation-decision": "npm --workspace @hcm-next/third-party-compensation-decision-api run dev",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "check:code-style": "node scripts/check-code-style.mjs",
    "check:code-style:staged": "node scripts/check-code-style.mjs --staged",
    "check:go": "node scripts/check-go-style.mjs",
    "check:race-policy": "node scripts/check-race-policy.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run src/tests/e2e src/workflows && npm run test --workspaces --if-present",
    "test:uxqual-browser": "go run ./tools/uxqual/cmd/genfixtures && playwright test -c tools/uxqual/browser/playwright.config.mjs",
    "test:go": "cd src/blocks/go && go test ./...",
    "test:all": "npm run format:check && npm run typecheck && npm run lint && npm run check:code-style && npm run check:go && npm run check:race-policy && npm run check:driftgate && npm run check:apigate && npm run check:substratecoverage && npm run check:enginecoverage && npm run test && npm run test:go && npm run build",
    "db:migrate": "npm --workspace @hcm-next/data-store run db:migrate",
    "db:seed": "npm --workspace @hcm-next/data-store run db:seed",
    "prepare": "husky",
    "check:driftgate": "go run ./tools/policy/driftgate/cmd/driftgate -root .",
    "check:apigate": "go run ./tools/policy/apigate/cmd/apigate -root .",
    "check:substratecoverage": "go run ./tools/policy/substratecoverage/cmd/substratecoverage -root .",
    "check:enginecoverage": "go run ./tools/policy/enginecoverage/cmd/enginecoverage -root ."
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.go": [
      "gofmt -w"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.1",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.6"
  }
}
