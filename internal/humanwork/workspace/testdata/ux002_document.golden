.layout-region[data-layout-compact-mode="grid"][data-layout-compact-columns="10"]{grid-template-columns:repeat(10,minmax(0,1fr))}
.layout-region[data-layout-compact-mode="grid"][data-layout-compact-columns="11"]{grid-template-columns:repeat(11,minmax(0,1fr))}
.layout-region[data-layout-compact-mode="grid"][data-layout-compact-columns="12"]{grid-template-columns:repeat(12,minmax(0,1fr))}
.layout-region[data-layout-compact-mode="grid"][data-layout-compact-stacked="true"]{grid-template-columns:1fr}
}
@media (min-width:60rem){
.layout-region[data-layout-standard-mode="flow"]{display:flex;flex-direction:column}
.layout-region[data-layout-standard-mode="grid"]{display:grid}
.layout-region[data-layout-standard-mode="grid"][data-layout-standard-columns="1"]{grid-template-columns:repeat(1,minmax(0,1fr))}
