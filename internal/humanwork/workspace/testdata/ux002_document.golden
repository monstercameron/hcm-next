.layout-region[data-layout-narrow-mode="grid"][data-layout-narrow-columns="12"]{grid-template-columns:repeat(12,minmax(0,1fr))}
.layout-region[data-layout-narrow-mode="grid"][data-layout-narrow-stacked="true"]{grid-template-columns:1fr}
@media (min-width:40rem){
.layout-region[data-layout-compact-mode="flow"]{display:flex;flex-direction:column}
.layout-region[data-layout-compact-mode="grid"]{display:grid}
.layout-region[data-layout-compact-mode="grid"][data-layout-compact-columns="1"]{grid-template-columns:repeat(1,minmax(0,1fr))}
