ut-standard-mode="grid"]{display:grid;}.layout-region[data-layout-standard-mode="grid"][data-layout-standard-columns="1"]{grid-template-columns:repeat(1,minmax(0,1fr));}.layout-region[data-layout-standard-mode="grid"][data-layout-standard-columns="2"]{grid-template-columns:repeat(2,minmax(0,1fr));}.layout-region[data-layout-standard-mode="grid"][data-layout-standard-columns="3"]{grid-template-columns:repeat(3,minmax(0,1fr));}.layout-region[data-layout-standard-mode="grid"][data-layout-standard-columns="4"]{grid-template-columns:repeat(4,minmax(0,1fr));}.layout-region[data-layout-standard-mode="grid"][data-layout-standard-columns="5"]{grid-template-columns:repeat(5,minmax(0,1fr));}.layout-region[data-layout-standard-mode="grid"][data-layout-standard-columns="6"]{grid-template-columns:repeat(6,minmax(0,1fr));}.layout-region[data-layout-standard-mode="grid"][data-layout-standard-columns="7"]{grid-template-columns:repeat(7,minmax(0,1fr));}.layout-region[data-layout-standard-mode="grid"][data-layout-standard-columns="8"]{grid-template-columns:repeat(8,minmax(0,1fr));}.layout-region[data-layout-standard-mode="grid"][data-layout-standard-columns="9"]{grid-template-columns:repeat(9,minmax(0,1fr));}.layout-region[data-layout-standard-mode="grid"][data-layout-standard-columns="10"]{grid-template-columns:repeat(10,minmax(0,1fr));}.layout-region[data-layout-standard-mode="grid"][data-layout-standard-columns="11"]{grid-template-columns:repeat(11,minmax(0,1fr));}.layout-region[data-layout-standard-mode="grid"][data-layout-standard-columns="12"]{grid-template-columns:repeat(12,minmax(0,1fr));}.layout-region[data-layout-standard-mode="grid"][data-layout-standard-stacked="true"]{grid-template-columns:1fr;}}@media (min-width:80rem){.layout-region[data-layout-wide-mode="flow"]{display:flex;flex-direction:column;}.layout-region[data-layout-wide-mode="grid"]{display:grid;}.layout-region[data-layout-wide-mode="grid"][data-layout-wide-columns="1"]{grid-template-columns:repeat(1,minmax(0,1