<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Promotion for Adrian Cole</title><style>:root{--color-accent:#1d4f91;--color-accent-text:#ffffff;--color-background:#ffffff;--color-border:#c7cad6;--color-danger:#a3123a;--color-danger-text:#ffffff;--color-info:#1a4f66;--color-success:#166534;--color-surface:#f4f5f8;--color-text:#1a1d29;--color-text-muted:#4a4f63;--color-warning:#7a4a00;--color-warning-text:#fff6e5;}*{box-sizing:border-box;}body{background-color:var(--color-background);color:var(--color-text);font:1rem/1.5 system-ui,sans-serif;margin:0;max-width:100%;overflow-wrap:anywhere;}.workspace{margin-bottom:0;margin-left:auto;margin-right:auto;margin-top:0;max-width:60rem;padding:1rem;}header.workspace-header{border-bottom:1px solid var(--color-border);padding:1rem;}main{display:flex;flex-direction:column;gap:1.5rem;padding:1rem;}@media (min-width:640px){main{display:grid;gap:1.5rem;grid-template-columns:1fr 1fr;}section.timeline,section.actions{grid-column:1 / -1;}}section{background-color:var(--color-surface);border:1px solid var(--color-border);border-radius:0.5rem;min-width:0;padding:1rem;}.field{display:flex;flex-direction:column;gap:0.25rem;margin-bottom:1rem;min-width:0;}.field label{font-weight:600;}.field input,.field textarea{border:1px solid var(--color-border);border-radius:0.25rem;font:inherit;max-width:100%;padding:0.5rem;width:100%;}.field .field-static{margin:0;padding-bottom:0.5rem;padding-left:0;padding-right:0;padding-top:0.5rem;}.field .error{color:var(--color-danger);font-size:0.875rem;}ul.findings,ol.timeline{display:flex;flex-direction:column;gap:0.5rem;list-style:none;margin:0;padding:0;}.finding,.check{border-inline-start:.25rem solid var(--color-border);padding-bottom:0.25rem;padding-left:0.75rem;padding-right:0.75rem;padding-top:0.25rem;}.finding[data-severity="blocking"],.check[data-severity="blocking"]{border-color:var(--color-danger);}.finding[data-severity="warning"],.check[data-severity="warning"]{border-color:var(--color-warning);}.finding[data-severity="success"],.check[data-severity="success"]{border-color:var(--color-success);}.finding[data-severity="info"],.check[data-severity="info"]{border-color:var(--color-info);}.status-banner{border-radius:0.25rem;font-weight:600;padding-bottom:0.75rem;padding-left:1rem;padding-right:1rem;padding-top:0.75rem;}.status-banner[data-status="ready"]{background-color:var(--color-success);color:var(--color-accent-text);}.status-banner[data-status="needs_review"],.status-banner[data-status="pending"]{background-color:var(--color-warning);color:var(--color-warning-text);}.status-banner[data-status="failed"]{background-color:var(--color-danger);color:var(--color-danger-text);}.actions{display:flex;flex-wrap:wrap;gap:0.75rem;}button{border:1px solid transparent;border-radius:0.25rem;cursor:pointer;font:inherit;padding-bottom:0.6rem;padding-left:1.2rem;padding-right:1.2rem;padding-top:0.6rem;}button[data-variant="primary"]{background-color:var(--color-accent);color:var(--color-accent-text);}button[data-variant="secondary"]{background-color:var(--color-surface);border-color:var(--color-border);color:var(--color-text);}button[data-variant="danger"]{background-color:var(--color-danger);color:var(--color-danger-text);}.visually-hidden{border:0;clip:rect(0,0,0,0);height:1px;margin:-1px;overflow:hidden;padding:0;position:absolute;white-space:nowrap;width:1px;}img,svg,video,canvas{height:auto;max-inline-size:100%;}:where(input,select,textarea,button){max-inline-size:100%;}pre{max-inline-size:100%;overflow:auto;}.widget-slot{max-inline-size:100%;min-inline-size:0;}.table-container,.table-scroll{max-inline-size:100%;min-inline-size:0;}.table-scroll{overflow-x:auto;overscroll-behavior-inline:contain;scrollbar-width:thin;touch-action:pan-x pan-y;}.table-scroll table{border-collapse:collapse;inline-size:max-content;min-inline-size:100%;table-layout:auto;}.table-scroll :where(th,td){min-