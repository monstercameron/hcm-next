@media (min-width:80rem){
.layout-region[data-layout-wide-mode="flow"]{display:flex;flex-direction:column}
.layout-region[data-layout-wide-mode="grid"]{display:grid}
.layout-region[data-layout-wide-mode="grid"][data-layout-wide-columns="1"]{grid-template-columns:repeat(1,minmax(0,1fr))}
